#!/usr/bin/env bash
# Install the professional Omarchy boot/shutdown splash with its native unlock dialog.
# Usage: omarchy-plymouth-professional [--restore]
set -euo pipefail

if (( EUID != 0 )); then
  exec sudo bash "$0" "$@"
fi

rebuild() {
  if command -v limine-mkinitcpio >/dev/null; then
    limine-mkinitcpio
  else
    mkinitcpio -P
  fi
}

backup=/etc/plymouth/plymouthd.conf.before-professional
if [[ ${1:-} == --restore ]]; then
  [[ -f $backup ]] || { echo 'Sauvegarde introuvable.' >&2; exit 1; }
  cp -a "$backup" /etc/plymouth/plymouthd.conf
  rebuild
  echo 'Ancien thème restauré.'
  exit 0
fi
[[ $# == 0 ]] || { echo 'Usage : omarchy-plymouth-professional [--restore]' >&2; exit 1; }

source_dir=/usr/share/omarchy/default/plymouth
target_dir=/usr/share/plymouth/themes/professional
[[ -f $source_dir/omarchy.plymouth && -f /usr/lib/plymouth/script.so ]]
command -v magick >/dev/null
[[ ! -L $target_dir ]]
if [[ ! -f $backup ]]; then
  if [[ $(plymouth-set-default-theme) == professional ]]; then
    echo 'Sauvegarde originale absente : refus de sauvegarder le thème professional comme original.' >&2
    exit 1
  fi
  cp -a /etc/plymouth/plymouthd.conf "$backup"
fi
install -d -m 0755 "$target_dir"
# Preserve Omarchy's integrated disk-unlock dialog and progress bar.
for asset in bullet.png entry.png lock.png progress_bar.png progress_box.png; do
  install -m 0644 "$source_dir/$asset" "$target_dir/$asset"
done
for asset in bullet.png entry.png lock.png progress_bar.png; do
  magick "$target_dir/$asset" -channel RGB +level-colors '#9ba3af','#9ba3af' "$target_dir/$asset"
done
base64 --decode > "$target_dir/logo.png" <<'OMARCHY_WORDMARK_PNG'
iVBORw0KGgoAAAANSUhEUgAAATgAAAA3CAMAAACvgKY5AAAAIGNIUk0AAHomAACAhAAA+gAAAIDo
