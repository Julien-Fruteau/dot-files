LLPMMssss8yy/4P9A1G56oA1Q7JiAAAAAElFTkSuQmCC
OMARCHY_WORDMARK_PNG
chmod 0644 "$target_dir/logo.png"
sed \
  -e 's/^Name=.*/Name=Professional/' \
  -e 's/^Description=.*/Description=Subtle Omarchy wordmark with the integrated Omarchy unlock dialog./' \
  -e 's|^ImageDir=.*|ImageDir=/usr/share/plymouth/themes/professional|' \
  -e 's|^ScriptFile=.*|ScriptFile=/usr/share/plymouth/themes/professional/professional.script|' \
  -e 's/^ConsoleLogBackgroundColor=.*/ConsoleLogBackgroundColor=0x101216/' \
  "$source_dir/omarchy.plymouth" > "$target_dir/professional.plymouth"
sed \
  -e 's/^Window.SetBackgroundTopColor.*/Window.SetBackgroundTopColor(0.063, 0.071, 0.086);/' \
  -e 's/^Window.SetBackgroundBottomColor.*/Window.SetBackgroundBottomColor(0.063, 0.071, 0.086);/' \
  -e 's|^logo.sprite.SetY(.*|logo.sprite.SetY(Window.GetHeight() / 2 - 75 - logo.image.GetHeight() / 2);|' \
  "$source_dir/omarchy.script" > "$target_dir/professional.script"
chmod 0644 "$target_dir/professional.plymouth"
chmod 0644 "$target_dir/professional.script"
plymouth-set-default-theme professional
if ! rebuild; then
  cp -a "$backup" /etc/plymouth/plymouthd.conf
  echo 'Reconstruction échouée : configuration précédente rétablie. Relancer la reconstruction avant de redémarrer.' >&2
  exit 1
fi
[[ $(plymouth-set-default-theme) == professional ]]
echo 'Splash professionnel activé pour le prochain démarrage et arrêt.'
