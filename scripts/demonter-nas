#!/usr/bin/env bash
set -u

base="$HOME/nas"
shares_list=$(pass show nas/shares) || exit "$?"
read -r -a shares <<< "$shares_list"

if [[ $# -gt 1 ]]; then
    echo "Usage : demonter-nas [partage]" >&2
    exit 2
fi

if [[ $# -eq 1 ]]; then
    found=false
    for share in "${shares[@]}"; do
        if [[ "$share" == "$1" ]]; then
            found=true
            break
        fi
    done
    if [[ "$found" == false ]]; then
        echo "Partage inconnu : $1" >&2
        exit 2
    fi
    shares=("$1")
fi

status=0
for share in "${shares[@]}"; do
    target="$base/$share"
    if ! mountpoint -q "$target"; then
        echo "Pas monté : $share"
        continue
    fi
    if sudo umount "$target"; then
        echo "Démonté : $share"
    else
        echo "Échec du démontage : $share" >&2
        status=1
    fi
done
exit "$status"
