#!/usr/bin/env bash
set -euo pipefail

nas="$(pass show nas/ip)"
shares_list=$(pass show nas/shares)
read -r -a shares <<< "$shares_list"
user='julien'
password="$(pass show nas/julien | head -n1)"
base="$HOME/nas"

if ! command -v mount.cifs >/dev/null; then
    echo "Il faut installer cifs-utils : lance task nas depuis le dépôt dot-files"
    exit 1
fi

sudo -v

mkdir -p "$base"

for share in "${shares[@]}"; do
    target="$base/$share"
    mkdir -p "$target"

    if mountpoint -q "$target"; then
        echo "Déjà monté : $share"
        continue
    fi

    sudo mount.cifs "//$nas/$share" "$target" \
        -o "username=$user,uid=$(id -u),gid=$(id -g),iocharset=utf8,domain=WORKGROUP,password=$(printf '%s' "$password" | sed 's/[,\\]/\\&/g')"
done

echo "Partages montés dans $base"
